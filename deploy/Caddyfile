# Caddy gets and renews the Let's Encrypt certificate for API_DOMAIN by itself
# (ports 80 and 443 must be open to the internet).
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	# Also carries the live-map WebSocket (/ws): Caddy proxies the Upgrade handshake by itself
	reverse_proxy app:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output stdout
		format console
	}
}
