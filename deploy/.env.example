# Copy to deploy/.env on the server, fill in, then: chmod 600 .env
# Never commit the filled-in file.

# --- Domain and HTTPS ---
# Public hostname of the API, pointing at the VM's public IP (e.g. skatemap.duckdns.org)
API_DOMAIN=
# Let's Encrypt account email (expiry notices)
ACME_EMAIL=

# --- Database (local container) ---
# Long random string: openssl rand -base64 32
DB_PASSWORD=

# --- Auth ---
# At least 64 random bytes, base64: openssl rand -base64 64
JWT_SECRET=
# The website lives on another site (Netlify), so the refresh cookie must be cross-site
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=None

# --- Google sign-in (one Web OAuth client) ---
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=

# --- CORS: the website's origin(s), comma separated ---
FRONTEND_URL=
CORS_ORIGINS=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI moderation ---
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Optional tuning (defaults suit an Ampere A1 with 12-24 GB) ---
# APP_MEM_LIMIT=4g
# DB_POOL_SIZE=30
# PG_SHARED_BUFFERS=1GB
# PG_EFFECTIVE_CACHE_SIZE=4GB
# Behind Cloudflare: CLIENT_IP_HEADER=CF-Connecting-IP (see README)
# CLIENT_IP_HEADER=X-Forwarded-For
